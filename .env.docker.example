# Contoh .env untuk Docker Compose (docs/deploy-docker.md). Salin menjadi .env
# di server, isi nilainya, dan jangan commit .env. Berkas ini dipasang ke
# container app; nilai lain dari .env.production.example tetap berlaku sebagai
# bawaan di image dan bisa ditimpa di sini (mis. MAIL_*).
#
# Jangan isi DB_ROOT_PASSWORD di sini: berikan lewat `export` di shell saat
# instalasi pertama agar tidak ikut masuk ke container app.

# Alamat situs persis, termasuk https://.
APP_URL=
# Buat dengan: php artisan key:generate --show (atau lihat docs/deploy-docker.md).
APP_KEY=
# Port host untuk HTTP; reverse proxy/TLS di depannya.
APP_PORT=8080

DB_DATABASE=pondok
DB_USERNAME=pondok
DB_PASSWORD=

# Akun super-admin pertama, dibuat sekali saat container pertama start.
# Hapus SUPER_ADMIN_PASSWORD setelah berhasil login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Cookie sesi hanya lewat HTTPS. Isi false hanya untuk uji lewat http:// tanpa TLS.
# SESSION_SECURE_COOKIE=true
