# Templat .env untuk server sekolah (cPanel). `php artisan pondok:install`
# menyalin berkas ini menjadi .env bila .env belum ada. Panduan lengkap:
# docs/instalasi.md

APP_NAME=Pondok
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Alamat situs persis, termasuk https://. Dipakai QR surat dan gambar portal.
APP_URL=https://pondok.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database MySQL/MariaDB yang dibuat di cPanel (nama database dan user biasanya
# diawali nama akun cPanel, mis. akun_pondok).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Pengiriman email lewat SMTP (akun email cPanel atau layanan lain).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.pondok.sch.id
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin@pondok.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Akun super-admin pertama, dibuat oleh `php artisan pondok:install`.
# Hapus nilai SUPER_ADMIN_PASSWORD setelah berhasil login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Opsional: proksi tepercaya (mis. Cloudflare), daftar IP/CIDR dipisah koma atau *.
# TRUSTED_PROXIES=

# Opsional (cara B): document root yang tidak bisa diubah, lalu jalankan
# `php artisan pondok:publish-public`.
# PONDOK_PUBLIC_PATH=/home/akun/public_html

# Opsional: bila hosting mematikan symlink, simpan unggahan publik langsung
# di folder web.
# PUBLIC_STORAGE_ROOT=/home/akun/pondok/public/storage

# Data demo (DemoSeeder) menolak berjalan di production; biarkan kosong.
DEMO_PASSWORD=
