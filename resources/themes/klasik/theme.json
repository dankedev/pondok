{
  "schema_version": 1,
  "version": "1.0.0",
  "min_core": "1.0.0",
  "slug": "klasik",
  "name": "Klasik",
  "description": "Header putih bergaris, beranda berselang-seling latar, dan footer gelap.",
  "header": {
    "component": "container",
    "style": {
      "tone": "light",
      "border": "bottom",
      "padding": {
        "base": "sm",
        "lg": "md"
      },
      "gap": "md",
      "width": "wide"
    },
    "children": [
      {
        "component": "brand"
      },
      {
        "component": "nav_menu"
      }
    ]
  },
  "footer": {
    "component": "container",
    "style": {
      "tone": "dark",
      "padding": {
        "base": "md",
        "lg": "lg"
      },
      "gap": "lg",
      "width": "wide"
    },
    "children": [
      {
        "component": "footer_widgets",
        "style": {
          "gap": "lg"
        }
      },
      {
        "component": "copyright",
        "style": {
          "border": "top"
        }
      }
    ]
  },
  "home": {
    "sections": {
      "hero": {
        "style": {
          "tone": "dark",
          "padding": {
            "base": "md",
            "md": "lg",
            "lg": "lg"
          },
          "align": "left"
        }
      },
      "text_image": {
        "style": {
          "tone": "auto",
          "padding": {
            "base": "md",
            "lg": "lg"
          },
          "gap": "lg"
        }
      },
      "features": {
        "style": {
          "tone": "muted",
          "padding": {
            "base": "md",
            "lg": "lg"
          },
          "gap": "md",
          "columns": {
            "base": 2,
            "md": 3,
            "lg": 3
          }
        }
      },
      "quote": {
        "style": {
          "tone": "brand",
          "padding": {
            "base": "md",
            "lg": "lg"
          },
          "align": "center"
        }
      },
      "cta": {
        "style": {
          "tone": "dark",
          "padding": {
            "base": "md",
            "lg": "lg"
          },
          "align": "center"
        }
      },
      "video": {
        "style": {
          "tone": "auto",
          "padding": {
            "base": "md",
            "lg": "lg"
          }
        }
      },
      "feed": {
        "style": {
          "tone": "auto",
          "padding": {
            "base": "md",
            "lg": "lg"
          }
        }
      }
    }
  }
}
